      Text: "\u0422\u0440\u0430\u0432\u0438\u0442\u044C"
    - Key: "\u041E\u0442\u043E\u0439\u0442\u0438"
      Text: "\u041D\u0430\u0442\u044F\u043D\u0443\u0442\u044C \u2014 \u0443\u0445\u043E\u0434\u044F
        \u043E\u0442 \u043C\u0430\u0447\u0442\u044B, \u0442\u043E\u0436\u0435 \u0432\u044B\u0431\u0438\u0440\u0430\u0435\u0448\u044C"
    - Key: "E \u043D\u0430 \u043D\u0430\u0433\u0435\u043B\u044C"
      Text: "\u0417\u0430\u0432\u044F\u0437\u0430\u0442\u044C"
    - Key: G
      Text: "\u0411\u0440\u043E\u0441\u0438\u0442\u044C \u043A\u043E\u043D\u0435\u0446"
