    Hints:
    - Key: "\u041B\u041A\u041C"
      Text: "\u0412\u044B\u0431\u0438\u0440\u0430\u0442\u044C \u043A\u0430\u043D\u0430\u0442
        (\u043F\u043E\u0434\u043D\u044F\u0442\u044C / \u043F\u043E\u0434\u0442\u044F\u043D\u0443\u0442\u044C)"
